cc_defaults {
    name: "display_defaults",
    cflags: [
        "-Wno-missing-field-initializers",
        "-Wconversion",
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
    ],
}

cc_library_headers {
    name: "debug_headers",
    vendor: true,
    export_include_dirs: [
        "libdebug",
    ],
}


subdirs = [
    "libqservice",
    "libqdutils",
]
